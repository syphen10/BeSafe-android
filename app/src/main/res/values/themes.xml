<resources>
    <style name="Theme.BeSafe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown by the system the instant the app is tapped: navy with the logo, no blank white frame.
         MainActivity then plays the short intro animation from the exact same position. -->
    <style name="Theme.BeSafe.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BeSafe</item>
    </style>
</resources>
