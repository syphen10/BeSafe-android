<resources>
    <style name="Theme.BeSafe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown by the system the instant the app is tapped: navy with a beating-heart logo while the
         app loads, then MainActivity fades it out as soon as the first frame is ready. -->
    <style name="Theme.BeSafe.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.BeSafe</item>
    </style>
</resources>
